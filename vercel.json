{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/health", "destination": "https://hermes-pro-api-commercial.onrender.com/health" },
    { "source": "/api/:path*", "destination": "https://hermes-pro-api-commercial.onrender.com/api/:path*" }
  ]
}
