# Hermes Pro local configuration template — never put real secrets in Git.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# AI provider: Gemini is the default. Calls may consume provider quota.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_AGENT_MODEL=gpt-6-astra
AI_API_KEY=

# Private API token used by the web app for AI/write/admin actions.
HERMES_API_TOKEN=

# Supabase: use a privileged server key for worker writes, never anon/publishable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternative for newer Supabase secret API keys:
SUPABASE_SECRET_KEY=
# Legacy aliases accepted by the runtime:
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# Queue and frontend
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173

# Commercial sales and notifications
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_WEBHOOK_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Canva OAuth (optional; requires an app configured with Canva)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=

# Freelance integrations remain disabled until explicitly authorized.
FREELANCER_ACCESS_TOKEN=
FREELANCER_SANDBOX=true
FREELANCER_ENABLED=false
FREELANCER_AUTO_APPLY=false
FREELANCER_BIDDER_ID=
FREELANCER_PROFILE_ID=

# Automation
AUTONOMY_ENABLED=true
AUTONOMY_MIN_SCORE=55
AUTONOMY_INTERVAL_SECONDS=900
